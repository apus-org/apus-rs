{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "apus-rs: build default: all",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--lib",
                "--examples"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true,
            }
        },
        {
            "label": "apus-rs: build release: all",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--lib",
                "--examples"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true,
            }
        }
    ]
}